# ============================================================
# CurseBot .env — Slayer Alliance Edition
# KOPIEER dit naar .env en vul JOUW waarden in
# ============================================================

# ── Discord (verplicht) ──────────────────────────────────────
DISCORD_TOKEN=jouw_discord_bot_token_hier
RELEASE_CHANNEL_ID=123456789012345678
# GUILD_ID=123456789012345678   # optioneel, voor snelle slash sync

# ── CurseForge (verplicht) ───────────────────────────────────
CURSEFORGE_API_KEY=jouw_curseforge_api_key_hier

# BELANGRIJK: dit zijn TWEE verschillende dingen!
#   CF_AUTHOR_SLUG = je gebruikersnaam als TEKST (bijv: dieouwe)
#   CF_AUTHOR_ID   = je numerieke ID als GETAL  (bijv: 1417946)
# Beide invullen voor beste resultaten!
CF_AUTHOR_SLUG=dieouwe
CF_AUTHOR_ID=1417946

# ── Instellingen ─────────────────────────────────────────────
CHECK_INTERVAL_MINUTES=10
LOG_LEVEL=INFO

# ── Dashboard ────────────────────────────────────────────────
DASHBOARD_ENABLED=true
DASHBOARD_PORT=5000

# ── Claude AI (optioneel) ────────────────────────────────────
# ANTHROPIC_API_KEY=jouw_anthropic_key_hier
# SUMMARIZE_CHANGELOGS=false
