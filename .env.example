# ─── CurseBot — .env configuratie ────────────────────────────────────────────
# Kopieer dit bestand naar .env en vul je eigen waarden in.
# NOOIT .env committen naar git — het staat in .gitignore

# Discord bot token (van https://discord.com/developers/applications)
DISCORD_TOKEN=jouw_discord_bot_token_hier

# ID van het channel waar release-embeds naartoe moeten
# Zet developer mode aan in Discord → rechtermuisklik op channel → Copy ID
RELEASE_CHANNEL_ID=1234567890123456789

# Optioneel: voor dev mode — slash commands alleen voor deze guild (sneller sync)
# Leeg laten voor productie (globale sync)
# GUILD_ID=9876543210987654321

# CurseForge API key (van https://console.curseforge.com/)
# Maak een nieuwe aan als je de vorige hebt gecompromitteerd!
CURSEFORGE_API_KEY=jouw_curseforge_api_key_hier

# CurseForge auteur slug (jouw gebruikersnaam op CurseForge)
CF_AUTHOR_SLUG=dieouwe

# Hoe vaak checken in minuten (10 = veilig binnen CF rate limits)
CHECK_INTERVAL_MINUTES=10

# SQLite database pad voor caching
DATABASE_PATH=cache.db

# Log level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ─── Optioneel: Claude API voor changelog samenvatting ────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# SUMMARIZE_CHANGELOGS=true
