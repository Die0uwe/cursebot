# ============================================================
# CurseBot — .env configuratie
# Kopieer dit bestand naar .env en vul je tokens in
# NOOIT dit bestand committen met echte waarden!
# ============================================================

# Discord (verplicht)
DISCORD_TOKEN=jouw_discord_bot_token_hier
RELEASE_CHANNEL_ID=123456789012345678

# Optioneel: voor snellere slash command sync (dev mode)
# GUILD_ID=123456789012345678

# CurseForge (verplicht)
CURSEFORGE_API_KEY=jouw_curseforge_api_key_hier
CF_AUTHOR_SLUG=dieouwe

# Optioneel maar STERK aanbevolen: numerieke author ID
# Voer find_author_id.py uit om dit getal te vinden
# CF_AUTHOR_ID=123456

# Polling interval (standaard: 10 minuten)
CHECK_INTERVAL_MINUTES=10

# Dashboard (standaard: aan op poort 5000)
DASHBOARD_ENABLED=true
DASHBOARD_PORT=5000

# Logging niveau (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# Claude AI changelog samenvatting (optioneel)
# ANTHROPIC_API_KEY=jouw_anthropic_key_hier
# SUMMARIZE_CHANGELOGS=false
